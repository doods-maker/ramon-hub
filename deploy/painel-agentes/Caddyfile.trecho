
# Painel dos agentes (ADR 0013): foreman-vision dentro do hub. Porta própria no mesmo domínio,
# para o cookie de sessão do hub chegar ao portão sem mexer no DNS.
chat.ramonantonio.adv.br:8443 {
	forward_auth chatwoot-web:3000 {
		uri /ramon_painel_agentes/portao
	}
	# As perguntas do plugin foreman não existem aqui: fica só a leitura e o esconder sessão.
	@perguntas path /api/ask /api/ask/*
	respond @perguntas 403
	header {
		Content-Security-Policy "frame-ancestors https://chat.ramonantonio.adv.br"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	reverse_proxy unix//run/esteira-vision-proxy/vision.sock {
		# O painel recusa qualquer outro Host (proteção contra DNS rebinding).
		header_up Host 127.0.0.1:4780
	}
}
