<%# app/views/cliente/painel/show.html.erb %>
<% content_for :aba, 'inicio' %>
<% pergunta_ia = Ramon::PortalTexto.v2? && current_cliente.ia_consentimento.nil? %>
<% if flash[:portal_notice] %><p class="flash flash-notice"><%= flash[:portal_notice] %></p><% end %>
<% if flash[:portal_alert] %><p class="flash flash-alert"><%= flash[:portal_alert] %></p><% end %>

<div class="topo-inicio">
  <div>
    <p class="data"><%= hoje_extenso %></p>
    <h1><%= saudacao %>, <%= current_cliente.primeiro_nome %></h1>
  </div>
  <div class="resumo">
    <a class="resumo-item t-fazer" href="<%= cliente_documentos_path %>">
      <span class="resumo-icone" style="color: var(--terracota)"><%= render 'icone', nome: 'alerta', tamanho: 17, traco: 2.2 %></span>
      <span class="resumo-num"><%= @resumo[:fazer] %></span>
      <span class="resumo-rotulo">Para você fazer</span>
    </a>
    <div class="resumo-item t-andamento">
      <span class="resumo-icone" style="color: var(--ouro)"><%= render 'icone', nome: 'andamento', tamanho: 17, traco: 2.2 %></span>
      <span class="resumo-num"><%= @resumo[:andamento] %></span>
      <span class="resumo-rotulo">Em andamento</span>
    </div>
    <div class="resumo-item t-aprovado">
      <span class="resumo-icone" style="color: var(--verde)"><%= render 'icone', nome: 'check', tamanho: 17, traco: 2.4 %></span>
      <span class="resumo-num"><%= @resumo[:aprovado] %></span>
      <span class="resumo-rotulo">Aprovado</span>
    </div>
  </div>
</div>

<div class="colunas">
  <div class="col-lateral" style="order: 2">
    <% if @assinaturas.any? || a_enviar.any? || pergunta_ia %>
      <h2 class="secao">Para você fazer</h2>
      <% if @assinaturas.any? || a_enviar.any? %>
        <div class="lista">
          <% @assinaturas.each do |a| %>
            <div class="linha">
              <span class="tile t-fazer"><%= render 'icone', nome: 'assinar', tamanho: 20 %></span>
              <span class="linha-texto"><strong>Assinar: <%= a.nome %></strong><small>Leva poucos minutos, pelo celular</small></span>
              <%= link_to 'Assinar', cliente_assinatura_path(a), class: 'btn-verde btn-pq' %>
            </div>
          <% end %>
          <% a_enviar.each do |processo, doc| %>
            <div class="linha">
              <span class="tile t-fazer"><%= render 'icone', nome: 'camera', tamanho: 20 %></span>
              <span class="linha-texto"><strong>Enviar: <%= doc['item'] %></strong><small><%= Ramon::PortalTexto.identificacao(processo).first %></small></span>
              <%= link_to 'Enviar', cliente_processo_path(processo['id'], anchor: 'documentos'), class: 'btn-verde btn-pq' %>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if pergunta_ia %>
        <div class="card">
          <p class="linha-texto"><strong>Uma pergunta rápida</strong></p>
          <p class="muted" style="margin-top: 6px">Podemos usar inteligência artificial para organizar a lista de documentos que pedimos a você?
            O texto do pedido, sem o seu nome e sem o seu CPF, é processado por um serviço com servidores na China.
            É opcional: sem a sua autorização, mostramos o pedido de forma resumida. Você pode mudar de ideia quando quiser,
            falando com a equipe.</p>
          <div class="acoes">
            <%= button_to 'Autorizo', cliente_ia_path(ia: 'sim'), method: :post, class: 'btn-bronze' %>
            <%= button_to 'Não autorizo', cliente_ia_path(ia: 'nao'), method: :post, class: 'btn-link' %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="col-principal">
    <h2 class="secao">Seus processos</h2>
    <% if @ativos.empty? && @encerrados.empty? %>
      <div class="neutral-card">Ainda não encontramos processos no seu nome. Se acha que é um engano, fale com a equipe.</div>
    <% end %>
    <% @ativos.each do |p| %><%= render 'processo_card', processo: p %><% end %>
    <% if @encerrados.any? %>
      <h2 class="secao">Encerrados</h2>
      <% @encerrados.each do |p| %><%= render 'processo_card', processo: p %><% end %>
    <% end %>
  </div>
</div>
