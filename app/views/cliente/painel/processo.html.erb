<%# app/views/cliente/painel/processo.html.erb %>
<% content_for :title, @etapa['titulo'] %>
<%= link_to '← Seus processos', cliente_inicio_path, class: 'btn-link voltar' %>
<% if flash[:portal_notice] %><p class="flash flash-notice"><%= flash[:portal_notice] %></p><% end %>
<% if flash[:portal_alert] %><p class="flash flash-alert"><%= flash[:portal_alert] %></p><% end %>

<section class="agora">
  <p class="eyebrow">Seu caso agora · <%= @processo['tipo'].to_s.downcase %></p>
  <% if @linha %>
    <% atual = @linha.index { |d| d['estado'] == 'current' } %>
    <ol class="trilha<%= ' trilha-longa' if @linha.size > 4 %>" aria-label="Fases do seu caso">
      <% @linha.each do |d| %>
        <li class="trilha-passo is-<%= d['estado'] %>"<%= ' aria-current="step"'.html_safe if d['estado'] == 'current' %>>
          <span class="trilha-icone"><%= render 'icone', nome: d['chave'], tamanho: 20 %></span>
          <span class="trilha-nome"><%= d['nome'] %></span>
          <span class="sr-only"><%= { 'done' => '(feita)', 'current' => '(agora)', 'future' => '(próxima)' }[d['estado']] %></span>
        </li>
      <% end %>
    </ol>
    <% if @linha.size > 4 && atual %>
      <p class="trilha-legenda">Fase <%= atual + 1 %> de <%= @linha.size %><% if @linha[atual + 1] %> · Próxima: <%= @linha[atual + 1]['nome'] %><% end %></p>
    <% end %>
  <% end %>
  <h1><%= @etapa['titulo'] %></h1>
  <p class="texto"><%= @etapa['o_que_esperar'] %></p>
  <% if @novidades.any? %><p class="badge badge-novo">Novidade</p><% end %>
</section>

<% if @pendentes.any? %>
  <h2 class="secao">Para você fazer</h2>
  <div class="docs-card">
    <p class="docs-title"><%= @pendentes.size == 1 ? 'Falta 1 documento' : "Faltam #{@pendentes.size} documentos" %></p>
    <p class="muted">Tire uma foto bem legível com o celular ou envie o arquivo em PDF.</p>
    <ul>
      <% @pendentes.each do |d| %>
        <li>
          <span class="doc-item"><%= render 'icone', nome: 'documentos', tamanho: 20 %><%= d['item'] %></span>
          <% if d['enviado'] %>
            <p><span class="badge badge-ok">Enviado — em conferência</span></p>
          <% else %>
            <%= form_tag cliente_envios_path(@processo['id']), multipart: true, class: 'upload-form' do %>
              <%= hidden_field_tag :item, d['item'] %>
              <%= hidden_field_tag :post_id, d['post_id'] %>
              <label class="foto">
                <%= file_field_tag :file, accept: 'image/*,application/pdf', required: true, class: 'foto-input', 'aria-label': "Arquivo: #{d['item']}" %>
                <span class="foto-icone"><%= render 'icone', nome: 'camera', tamanho: 26 %></span>
                <span class="foto-texto" data-vazio="Tirar foto ou escolher arquivo">Tirar foto ou escolher arquivo</span>
              </label>
              <%= submit_tag 'Enviar', class: 'btn-bronze' %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @recado.present? %>
  <h2 class="secao">Recado da equipe</h2>
  <div class="card recado"><%= render 'icone', nome: 'recado', tamanho: 22 %><div><%= simple_format(@recado) %></div></div>
<% end %>

<% if @marcos.any? %>
  <h2 class="secao">O que já aconteceu</h2>
  <div class="timeline">
    <% @marcos.reverse.each_with_index do |m, i| %>
      <div class="step">
        <div class="step-rail"><span class="dot-done"></span><% unless i == @marcos.size - 1 %><span class="rail-done"></span><% end %></div>
        <div class="step-text">
          <p class="step-title"><span class="step-data"><%= data_br(m['data']) %></span><%= m['titulo'] %></p>
          <p class="step-sub"><%= m['explicacao'] %></p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="secao">Dados do processo</h2>
<div class="card">
  <dl class="dados">
    <div><dt>Número</dt><dd><%= @processo['numero'].presence || '—' %></dd></div>
    <div><dt>Início</dt><dd><%= data_br(@processo['inicio']) || '—' %></dd></div>
    <div><dt>Advogado(a) responsável</dt><dd><%= @processo['responsavel'].to_s.titleize.presence || 'Equipe' %></dd></div>
  </dl>
  <a class="btn-bronze btn-whats" href="https://wa.me/<%= ENV.fetch('PORTAL_WHATSAPP', '5548988554077') %>"><%= render 'icone', nome: 'conversa', tamanho: 22 %>Falar com a equipe no WhatsApp</a>
</div>
<script>
  // Mostra o nome do arquivo escolhido no lugar de "Tirar foto ou escolher arquivo".
  document.querySelectorAll('.foto-input').forEach(function (input) {
    input.addEventListener('change', function () {
      var texto = input.parentNode.querySelector('.foto-texto');
      var arquivo = input.files[0];
      texto.textContent = arquivo ? 'Escolhido: ' + arquivo.name : texto.dataset.vazio;
      input.parentNode.classList.toggle('tem-arquivo', !!arquivo);
    });
  });
</script>
