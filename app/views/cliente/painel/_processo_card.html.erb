<%# app/views/cliente/painel/_processo_card.html.erb %>
<% etapa = Ramon::PortalTexto.etapa(PortalCliente.etapa_cliente(processo)) %>
<% faltam = processo['docs_pendentes'].size %>
<%= link_to cliente_processo_path(processo['id']), class: 'card' do %>
  <span class="badge"><%= processo['tipo'].to_s.downcase.capitalize %></span>
  <% if PortalCliente.novidades_nao_vistas(processo).any? %><span class="badge badge-novo">Novidade</span><% end %>
  <h2><%= etapa['titulo'] %></h2>
  <p class="muted"><%= etapa['o_que_esperar'] %></p>
  <div class="card-rodape">
    <% if faltam.positive? %>
      <span class="alerta-docs"><%= faltam == 1 ? 'Falta 1 documento' : "Faltam #{faltam} documentos" %></span>
    <% else %>
      <span class="muted">Nada pendente com você</span>
    <% end %>
    <span class="ver-mais">Ver detalhes →</span>
  </div>
<% end %>
