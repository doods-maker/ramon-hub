<%# app/views/cliente/painel/_processo_card.html.erb %>
<% etapa = Ramon::PortalTexto.etapa(PortalCliente.etapa_cliente(processo)) %>
<% titulo, sub = Ramon::PortalTexto.identificacao(processo) %>
<% tom, rotulo = Ramon::PortalTexto.status(processo) %>
<% faltam = a_enviar.count { |p, _d| p['id'] == processo['id'] } %>
<% linha = Ramon::PortalTexto.linha_do_tempo(processo) if Ramon::PortalTexto.v2? %>
<% atual = linha&.find { |d| d['estado'] == 'current' } %>
<%= link_to cliente_processo_path(processo['id']), class: 'card' do %>
  <div class="proc-topo">
    <span class="tile t-<%= tom %>"><%= render 'icone', nome: atual ? atual['chave'] : 'documentos', tamanho: 20 %></span>
    <span class="proc-nome"><strong><%= titulo %></strong><% if sub %><small><%= sub %></small><% end %></span>
    <span class="selo t-<%= tom %>"><% if tom == 'aprovado' %><%= render 'icone', nome: 'check', tamanho: 11, traco: 3.2 %><% else %><span class="selo-ponto"></span><% end %><%= rotulo %></span>
  </div>
  <div class="proc-corpo">
    <p class="proc-etapa">
      <span><%= etapa['titulo'] %></span>
      <% if faltam.positive? %><span class="proc-pendencia"><%= faltam == 1 ? '1 pendência' : "#{faltam} pendências" %></span><% end %>
    </p>
    <% if PortalCliente.novidades_nao_vistas(processo).any? %><span class="badge badge-novo" style="margin-top: 6px">Novidade</span><% end %>
    <% if linha %>
      <div class="progresso" aria-hidden="true"><% linha.each do |passo| %><span class="is-<%= passo['estado'] %>"></span><% end %></div>
    <% end %>
  </div>
<% end %>
