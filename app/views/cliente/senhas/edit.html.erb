<%# app/views/cliente/senhas/edit.html.erb %>
<div class="topo">
  <p class="eyebrow">Painel do cliente</p>
  <h1>Escolha uma senha nova</h1>
  <p class="lead">Use só números, com pelo menos 6 dígitos.</p>
</div>
<% if flash[:portal_alert] %><p class="flash flash-alert"><%= flash[:portal_alert] %></p><% end %>
<div class="card">
  <%= form_with url: cliente_senha_path, method: :patch, local: true, class: 'form-portal' do |f| %>
    <% if pedir_senha_atual? %>
      <%= f.label :senha_atual, 'Senha atual', class: 'label' %>
      <%= f.password_field :senha_atual, required: true, autocomplete: 'current-password', inputmode: 'numeric', class: 'input' %>
    <% end %>
    <%= f.label :senha, 'Nova senha', class: 'label' %>
    <%= f.password_field :senha, required: true, autocomplete: 'new-password', inputmode: 'numeric', pattern: '[0-9]{6,}', class: 'input' %>
    <%= f.label :confirmacao, 'Repita a nova senha', class: 'label' %>
    <%= f.password_field :confirmacao, required: true, autocomplete: 'new-password', inputmode: 'numeric', pattern: '[0-9]{6,}', class: 'input' %>
    <%= f.submit 'Salvar senha', class: 'btn-bronze' %>
  <% end %>
</div>
<%= link_to 'Agora não', cliente_inicio_path, class: 'btn-link' %>
