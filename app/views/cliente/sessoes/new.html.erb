<%# app/views/cliente/sessoes/new.html.erb %>
<div class="topo">
  <p class="eyebrow">Painel do cliente</p>
  <h1>Acompanhe o seu caso</h1>
  <p class="lead">Entre com o CPF e a senha que o escritório passou para você.</p>
</div>
<% if flash[:portal_alert] %><p class="flash flash-alert"><%= flash[:portal_alert] %></p><% end %>
<div class="card">
  <%= form_with url: cliente_entrar_path, method: :post, local: true, class: 'form-portal' do |f| %>
    <%= f.label :cpf, 'Seu CPF', class: 'label' %>
    <%= f.text_field :cpf, value: params[:cpf], required: true, autocomplete: 'username', inputmode: 'numeric', class: 'input', placeholder: '000.000.000-00' %>
    <%= f.label :senha, 'Sua senha', class: 'label' %>
    <%= f.password_field :senha, required: true, autocomplete: 'current-password', inputmode: 'numeric', class: 'input' %>
    <%= f.submit 'Entrar', class: 'btn-bronze' %>
  <% end %>
</div>
<%= link_to 'Esqueci a senha', cliente_esqueci_path, class: 'btn-link' %>
<p class="muted">Você pode trocar a senha depois de entrar.</p>
