<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#ffffff">
  <title><%= content_for?(:title) ? yield(:title) : 'Acompanhamento do seu caso' %> · Ramon Antonio Advogados</title>
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@700&display=swap" rel="stylesheet">
  <%# Página pública standalone fora da SPA — CSS inline permitido aqui. Usado pelo Painel do Cliente e pelo
      portal do lead (public/portal). Visual 03/10 (mock aprovado pelo Eduardo no canvas do Claude):
      NEUTRO + marrom só na marca; cores de STATUS terrosas — terracota = precisa de você, ouro = em andamento,
      verde = feito/ação, pedra = em análise (nunca antecipa resultado). Plus Jakarta Sans; Cormorant só no
      nome do escritório. Menu: barra embaixo no celular, lateral a partir de 960px (content_for :aba). %>
  <style>
    :root {
      --fundo: #f6f5f3; --branco: #fff; --linha: #e8e5df; --linha-suave: #f0ede8; --quadro: #f8f6f2;
      --tinta: #1a1714; --tinta-2: #4a453f; --apoio: #6b655d; --sutil: #8a847b; --apagado: #a8a196; --tracejado: #d6d1c8;
      --marrom: #3b2010; --bronze: #754d2a; --bronze-escuro: #5a3a1f; --bronze-tinta: #f3ece4;
      --terracota: #b4532a; --terracota-texto: #9a3f1c; --terracota-tinta: #fbeee7;
      --ouro: #c9a446; --ouro-texto: #7d5c0e; --ouro-tinta: #f8f0da;
      --verde: #2f6b4a; --verde-escuro: #255a3d; --verde-texto: #285c40; --verde-tinta: #e6f0e9;
      --pedra-tinta: #efede9;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--fundo); color: var(--tinta); font-family: 'Plus Jakarta Sans', 'Segoe UI', Roboto, Arial, sans-serif;
      font-size: 16px; line-height: 1.5; min-height: 100vh; -webkit-font-smoothing: antialiased;
    }
    a { color: var(--bronze); }
    :focus-visible { outline: 3px solid var(--ouro); outline-offset: 2px; border-radius: 8px; }
    .num { font-variant-numeric: tabular-nums; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ── Topo ───────────────────────────────────── */
    .topo-app { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--branco); border-bottom: 1px solid var(--linha); }
    .marca-mini { width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0; }
    .marca-nome { flex: 1; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 19px; font-weight: 700; color: var(--marrom); line-height: 1; }
    .marca-nome span { display: block; margin-top: 2px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 8.5px; font-weight: 700; letter-spacing: .32em; color: var(--bronze); }
    .avatar { width: 36px; height: 36px; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: var(--bronze-tinta); color: var(--marrom); font-size: 15px; font-weight: 800; text-decoration: none; flex-shrink: 0; }
    .topo-voltar-link { width: 36px; height: 36px; margin-left: -6px; border-radius: 999px; display: flex; align-items: center; justify-content: center; color: var(--marrom); flex-shrink: 0; }
    .topo-titulo { flex: 1; min-width: 0; font-size: 16px; font-weight: 800; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .topo-voltar .marca-mini { width: 30px; height: 30px; border-radius: 8px; }

    .pagina { max-width: 600px; margin: 0 auto; padding: 20px 16px 28px; }

    /* ── Texto ──────────────────────────────────── */
    .data { font-size: 13px; font-weight: 600; color: var(--apoio); }
    h1 { font-size: 26px; font-weight: 800; line-height: 1.15; letter-spacing: -.025em; color: var(--tinta); }
    .eyebrow { font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--apoio); }
    .lead { margin-top: 6px; font-size: 15.5px; color: var(--tinta-2); }
    .topo { margin-bottom: 20px; }
    .divider { display: none; }
    .secao { display: flex; align-items: center; gap: 8px; margin: 26px 0 10px; font-size: 17px; font-weight: 800; letter-spacing: -.01em; }
    .contador { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: var(--terracota); color: #fff; font-size: 11.5px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; }
    .muted { font-size: 14px; color: var(--apoio); }
    .flash { margin: 0 0 16px; padding: 12px 14px; border-radius: 12px; font-size: 15px; font-weight: 600; }
    .flash-notice { background: var(--verde-tinta); color: var(--verde-texto); }
    .flash-alert { background: var(--terracota-tinta); color: var(--terracota-texto); }
    .compliance { margin-top: 26px; font-size: 12.5px; line-height: 1.5; color: var(--sutil); }

    /* ── Tons de status ─────────────────────────── */
    .t-fazer { background: var(--terracota-tinta); color: var(--terracota-texto); }
    .t-andamento { background: var(--ouro-tinta); color: var(--ouro-texto); }
    .t-aprovado { background: var(--verde-tinta); color: var(--verde-texto); }
    .t-analise, .t-concluido { background: var(--pedra-tinta); color: var(--tinta-2); }
    .selo { flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; font-size: 12px; font-weight: 800; white-space: nowrap; }
    .selo-ponto { width: 6px; height: 6px; border-radius: 99px; background: currentColor; }
    .t-andamento .selo-ponto { background: var(--ouro); }

    /* Resumo do início: 3 blocos */
    .resumo { margin-top: 16px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .resumo-item { display: flex; flex-direction: column; gap: 8px; padding: 12px; border-radius: 16px; text-decoration: none; }
    .resumo-icone { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; background: var(--branco); }
    .resumo-num { font-size: 26px; font-weight: 800; line-height: 1; letter-spacing: -.02em; }
    .resumo-rotulo { font-size: 12.5px; font-weight: 700; line-height: 1.2; color: var(--tinta-2); }

    /* ── Cartões e listas ───────────────────────── */
    .card, .lista, .neutral-card, .docs-card { background: var(--branco); border: 1px solid var(--linha); border-radius: 16px; }
    .card, .neutral-card, .docs-card { display: block; padding: 14px; margin-bottom: 8px; color: var(--tinta); text-decoration: none; }
    .neutral-card { color: var(--tinta-2); }
    a.card { transition: border-color .15s, box-shadow .15s; }
    a.card:hover { border-color: #d9d4cb; box-shadow: 0 4px 16px rgba(26, 23, 20, .06); }
    .lista { overflow: hidden; margin-bottom: 8px; }
    .linha { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 14px; border-top: 1px solid var(--linha-suave); color: var(--tinta); text-decoration: none; }
    .linha:first-child { border-top: 0; }
    .linha-botao { width: 100%; background: none; border: 0; font: inherit; text-align: left; cursor: pointer; }
    .linha-texto { flex: 1; min-width: 0; line-height: 1.3; }
    .linha-texto strong { display: block; font-size: 15.5px; font-weight: 700; }
    .linha-texto small { display: block; font-size: 13px; color: var(--apoio); }
    .tile { width: 40px; height: 40px; border-radius: 11px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .tile-marca { background: var(--bronze-tinta); color: var(--bronze); }
    .seta { color: var(--apagado); flex-shrink: 0; }

    /* Card de processo */
    .proc-topo { display: flex; align-items: center; gap: 12px; }
    .proc-nome { flex: 1; min-width: 0; line-height: 1.3; }
    .proc-nome strong { display: block; font-size: 16px; font-weight: 800; }
    .proc-nome small { display: block; font-size: 12.5px; color: var(--apoio); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .proc-corpo { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--linha-suave); }
    .proc-etapa { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14.5px; font-weight: 700; }
    .proc-pendencia { flex-shrink: 0; font-size: 12px; font-weight: 800; color: var(--terracota-texto); }
    .progresso { margin-top: 8px; display: flex; gap: 4px; }
    .progresso span { flex: 1; height: 5px; border-radius: 99px; background: var(--linha); }
    .progresso .is-done { background: var(--verde); }
    .progresso .is-current { background: var(--ouro); }
    .badge { display: inline-block; font-size: 12px; font-weight: 800; padding: 3px 9px; border-radius: 999px; background: var(--pedra-tinta); color: var(--tinta-2); }
    .badge-novo { background: var(--bronze-tinta); color: var(--bronze-escuro); }
    .badge-ok { background: var(--verde-tinta); color: var(--verde-texto); }

    /* ── Botões ─────────────────────────────────── */
    .btn-bronze, .btn-verde {
      display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 50px; padding: 12px 20px;
      font: inherit; font-size: 16px; font-weight: 700; text-align: center; text-decoration: none; border-radius: 12px; border: none; cursor: pointer;
      color: #fff; transition: background .15s, transform .1s;
    }
    .btn-bronze { background: var(--bronze); }
    .btn-bronze:hover { background: var(--bronze-escuro); }
    .btn-verde { background: var(--verde); }
    .btn-verde:hover { background: var(--verde-escuro); }
    .btn-bronze:active, .btn-verde:active { transform: scale(.98); }
    .btn-pq { width: auto; min-height: 40px; padding: 0 14px; font-size: 14.5px; border-radius: 10px; flex-shrink: 0; }
    .btn-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 6px 0; background: none; border: 0; font: inherit; font-size: 15px; font-weight: 700; color: var(--bronze); text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
    .btn-contorno { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 50px; border-radius: 12px; border: 1.5px solid var(--linha); background: var(--branco); color: var(--terracota-texto); font: inherit; font-size: 16px; font-weight: 700; cursor: pointer; }
    .acoes { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }

    /* ── Página do processo ─────────────────────── */
    .status-card { background: var(--branco); border: 1px solid var(--linha); border-radius: 18px; padding: 16px; }
    .status-topo { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12.5px; color: var(--apoio); }
    .trilha { list-style: none; display: flex; margin: 18px -4px 16px; }
    .trilha-passo { flex: 1; min-width: 0; position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
    .trilha-passo:not(:first-child)::before { content: ''; position: absolute; top: 17px; right: 50%; width: 100%; height: 2px; background: repeating-linear-gradient(90deg, var(--tracejado) 0 5px, transparent 5px 9px); }
    .trilha-passo.is-done::before, .trilha-passo.is-current::before { background: var(--verde); }
    .trilha-icone { position: relative; z-index: 1; width: 36px; height: 36px; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: var(--branco); border: 1.5px solid var(--tracejado); color: var(--apagado); }
    .is-done .trilha-icone { background: var(--verde); border-color: var(--verde); color: #fff; }
    .is-current .trilha-icone { border: 2.5px solid var(--ouro); color: var(--ouro-texto); box-shadow: 0 0 0 4px var(--ouro-tinta); }
    .trilha-nome { font-size: 12px; line-height: 1.25; color: var(--sutil); }
    .is-done .trilha-nome { color: var(--tinta-2); font-weight: 600; }
    .is-current .trilha-nome { color: var(--tinta); font-weight: 800; }
    .trilha-longa .trilha-nome { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .trilha-longa .is-current .trilha-nome { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: nowrap; }
    .trilha-longa .is-current:last-child { align-items: flex-end; }
    .trilha-legenda { margin: -8px 0 14px; font-size: 13px; color: var(--apoio); }
    .agora { padding: 14px; border-radius: 14px; background: var(--quadro); }
    .agora .eyebrow { color: var(--ouro-texto); }
    .agora h1 { margin-top: 3px; font-size: 20px; line-height: 1.25; letter-spacing: -.02em; }
    .agora p.texto { margin-top: 6px; font-size: 14.5px; color: var(--tinta-2); }
    .agora .badge-novo { margin-top: 10px; }

    /* Envio de documento */
    .envio { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; margin-top: 12px; }
    .foto {
      position: relative; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 6px 10px;
      border: 1.5px dashed #d9c4b6; border-radius: 12px; background: #fdf8f5; color: var(--terracota-texto); font-size: 14.5px; font-weight: 700; cursor: pointer;
    }
    .foto:focus-within { outline: 3px solid var(--ouro); outline-offset: 2px; }
    .foto.tem-arquivo { border-style: solid; border-color: var(--verde); background: var(--verde-tinta); color: var(--verde-texto); }
    .foto-input { position: absolute; inset: 0; opacity: 0; width: 100%; cursor: pointer; }
    .foto-texto { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .so-pc { display: none; }
    .envio .btn-verde { min-height: 46px; padding: 0 18px; }

    /* Histórico e dados */
    .dia { flex-shrink: 0; width: 48px; text-align: center; padding: 4px 0; border-radius: 10px; background: var(--fundo); line-height: 1.1; }
    .dia strong { display: block; font-size: 17px; font-weight: 800; }
    .dia small { display: block; font-size: 11px; font-weight: 700; color: var(--apoio); text-transform: uppercase; }
    .dados { padding: 4px 14px; }
    .dados div { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; border-top: 1px solid var(--linha-suave); font-size: 14.5px; }
    .dados div:first-child { border-top: 0; }
    .dados dt { color: var(--apoio); }
    .dados dd { font-weight: 700; text-align: right; word-break: break-word; }

    /* Equipe */
    .pessoa { display: flex; align-items: center; gap: 12px; }
    .pessoa-inicial { width: 48px; height: 48px; border-radius: 999px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--bronze-tinta); color: var(--marrom); font-size: 18px; font-weight: 800; }

    /* ── Formulários (login, senha, termos) ─────── */
    .form-portal { display: flex; flex-direction: column; gap: 6px; }
    .form-portal .btn-bronze { margin-top: 12px; }
    .label { font-size: 15px; font-weight: 700; margin-top: 8px; }
    .label:first-child { margin-top: 0; }
    .input { width: 100%; padding: 13px 14px; border: 1.5px solid var(--linha); border-radius: 12px; font: inherit; font-size: 18px; background: var(--fundo); color: var(--tinta); }
    .input:focus { border-color: var(--bronze); background: var(--branco); outline: none; box-shadow: 0 0 0 4px var(--bronze-tinta); }
    .input-codigo { letter-spacing: .4em; text-align: center; font-size: 24px; }
    label.check { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; }
    label.check input { width: 22px; height: 22px; margin-top: 2px; accent-color: var(--bronze); flex-shrink: 0; }
    .termos { padding-left: 20px; font-size: 15px; }
    .termos li { margin-top: 10px; }
    .termos li:first-child { margin-top: 0; }
    .iframe-assinatura { width: 100%; height: 78vh; border: 0; border-radius: 14px; background: #fff; }

    /* Portal do lead (public/portal) */
    .docs-card .docs-title { font-size: 16px; font-weight: 800; margin-bottom: 6px; }
    .docs-card ul { list-style: none; }
    .docs-card li { padding: 10px 0; border-top: 1px solid var(--linha-suave); font-weight: 600; }
    .docs-card li:first-child { border-top: 0; }
    .docs-card .docs-hint { margin-top: 8px; font-size: 14px; color: var(--apoio); }
    .upload-form { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; }
    .upload-form input[type="file"] { width: 100%; font: inherit; font-size: 14px; padding: 8px; border: 1.5px dashed var(--tracejado); border-radius: 12px; background: var(--fundo); }
    .timeline { display: flex; flex-direction: column; margin-bottom: 12px; }
    .step { display: flex; gap: 14px; }
    .step-rail { display: flex; flex-direction: column; align-items: center; width: 22px; flex-shrink: 0; }
    .step-text { padding-bottom: 18px; flex: 1; }
    .step:last-child .step-text { padding-bottom: 0; }
    .dot-done, .dot-current, .dot-future { width: 22px; height: 22px; border-radius: 999px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .dot-done { background: var(--verde); }
    .dot-current { background: var(--branco); border: 2.5px solid var(--ouro); }
    .dot-current span { width: 8px; height: 8px; border-radius: 99px; background: var(--ouro); }
    .dot-future { background: var(--branco); border: 1.5px solid var(--tracejado); }
    .rail-done, .rail-future { width: 2px; flex: 1; min-height: 22px; }
    .rail-done { background: var(--verde); }
    .rail-future { background: var(--linha); }
    .step-title { font-size: 15.5px; font-weight: 700; }
    .step-title-future { font-size: 15.5px; color: var(--sutil); }
    .step-sub { margin-top: 2px; font-size: 14px; color: var(--apoio); }
    .pill-now { margin-left: 6px; padding: 2px 8px; font-size: 11.5px; font-weight: 800; border-radius: 999px; background: var(--ouro-tinta); color: var(--ouro-texto); }

    /* ── Menu: barra embaixo (celular) ──────────── */
    body.com-menu { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
    .menu {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; background: var(--branco);
      border-top: 1px solid var(--linha); padding: 6px 4px calc(10px + env(safe-area-inset-bottom));
    }
    .menu-marca, .menu-ajuda { display: none; }
    .menu-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; min-height: 52px; text-decoration: none; color: var(--apoio); font-size: 11.5px; font-weight: 700; }
    .menu-icone { position: relative; width: 56px; height: 30px; border-radius: 999px; display: flex; align-items: center; justify-content: center; }
    .menu-item[aria-current="page"] { color: var(--marrom); font-weight: 800; }
    .menu-item[aria-current="page"] .menu-icone { background: var(--bronze-tinta); }
    .menu-badge { position: absolute; top: -2px; right: 9px; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 999px; background: var(--terracota); color: #fff; font-size: 10.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 2px var(--branco); }

    /* ── Computador: menu lateral + duas colunas ── */
    @media (min-width: 960px) {
      body.com-menu { padding: 0 0 0 248px; }
      .com-menu .menu {
        top: 0; right: auto; width: 248px; flex-direction: column; gap: 2px; padding: 22px 14px;
        border-top: 0; border-right: 1px solid var(--linha);
      }
      .com-menu .menu-marca { display: flex; align-items: center; gap: 11px; padding: 0 8px 26px; }
      .com-menu .menu-marca .marca-mini { width: 40px; height: 40px; border-radius: 11px; }
      .com-menu .menu-marca .marca-nome { font-size: 21px; }
      .menu-item { position: relative; flex: none; flex-direction: row; gap: 12px; min-height: 46px; padding: 0 12px; border-radius: 11px; font-size: 16px; color: var(--tinta-2); }
      .menu-icone { width: auto; height: auto; background: none !important; position: static; }
      .menu-item[aria-current="page"] { background: var(--bronze-tinta); }
      .menu-badge { top: 50%; right: 12px; transform: translateY(-50%); min-width: 22px; height: 22px; font-size: 12px; box-shadow: none; }
      .menu-nome { flex: 1; }
      .com-menu .menu-ajuda { display: block; margin-top: auto; padding: 14px; border-radius: 14px; background: var(--fundo); border: 1px solid var(--linha-suave); font-size: 14px; color: var(--apoio); }
      .menu-ajuda .btn-verde { margin-top: 8px; min-height: 42px; padding: 0 12px; font-size: 14.5px; border-radius: 10px; white-space: nowrap; }
      .com-menu .topo-app:not(.topo-voltar) { display: none; }
      .com-menu .topo-voltar { padding: 14px 48px; }
      .com-menu .topo-voltar .marca-mini { display: none; }
      .com-menu .pagina { max-width: 1080px; padding: 36px 48px 40px; }
      h1 { font-size: 34px; }
      .colunas { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; align-items: start; }
      .col-lateral .secao:first-child, .col-principal .secao:first-child { margin-top: 0; }
      .topo-inicio { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 30px; }
      .topo-inicio .resumo { margin-top: 0; grid-template-columns: repeat(3, 150px); }
      .so-celular { display: none; }
      .so-pc { display: inline; }
      .trilha-passo .trilha-nome { position: static !important; width: auto !important; height: auto !important; clip: auto !important; font-size: 13.5px; }
      .trilha-legenda { display: none; }
    }
    @media (min-width: 640px) { .pagina { padding-top: 28px; } }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</head>
<body class="<%= 'com-menu' if content_for?(:aba) %>">
  <% if content_for?(:aba) %>
    <% aba = yield(:aba).to_s.strip %>
    <nav class="menu" aria-label="Menu">
      <div class="menu-marca">
        <img class="marca-mini" src="/brand-assets/ramon-monogram.png" alt="" width="150" height="150">
        <p class="marca-nome">Ramon Antonio<span>ADVOGADOS</span></p>
      </div>
      <% [['inicio', 'Início', cliente_inicio_path, 'casa'], ['documentos', 'Documentos', cliente_documentos_path, 'documentos'],
          ['equipe', 'Equipe', cliente_equipe_path, 'equipe'], ['conta', 'Conta', cliente_conta_path, 'conta']].each do |chave, nome, url, icone| %>
        <a class="menu-item" href="<%= url %>"<%= ' aria-current="page"'.html_safe if aba == chave %>>
          <span class="menu-icone"><%= render 'cliente/painel/icone', nome: icone, tamanho: 21, traco: (aba == chave ? 2.1 : 1.9) %><% if chave == 'documentos' && pendencias.positive? %><span class="menu-badge" aria-label="<%= pendencias %> pendentes"><%= pendencias %></span><% end %></span>
          <span class="menu-nome"><%= nome %></span>
        </a>
      <% end %>
      <div class="menu-ajuda">
        Dúvidas sobre o seu caso?
        <a class="btn-verde" href="<%= cliente_equipe_path %>"><%= render 'cliente/painel/icone', nome: 'conversa', tamanho: 18 %>Falar com a equipe</a>
      </div>
    </nav>
  <% end %>
  <header class="topo-app<%= ' topo-voltar' if content_for?(:voltar) %>">
    <% if content_for?(:voltar) %>
      <a class="topo-voltar-link" href="<%= yield(:voltar) %>" aria-label="Voltar"><%= render 'cliente/painel/icone', nome: 'voltar', tamanho: 22, traco: 2.2 %></a>
      <p class="topo-titulo"><%= yield(:topo_titulo) %></p>
      <img class="marca-mini" src="/brand-assets/ramon-monogram.png" alt="Ramon Antonio Advogados" width="150" height="150">
    <% else %>
      <img class="marca-mini" src="/brand-assets/ramon-monogram.png" alt="" width="150" height="150">
      <p class="marca-nome">Ramon Antonio<span>ADVOGADOS</span></p>
      <% if content_for?(:aba) %><a class="avatar" href="<%= cliente_conta_path %>" aria-label="Minha conta"><%= current_cliente.primeiro_nome.first %></a><% end %>
    <% end %>
  </header>
  <main class="pagina">
    <%= yield %>
    <p class="compliance">Conteúdo informativo sobre o andamento do seu atendimento. Não substitui a orientação jurídica individual de um(a) advogado(a).</p>
  </main>
</body>
</html>
