<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ramon Hub — resumo de ontem</title>
  </head>
  <body style="margin:0;padding:0;background-color:#faf3e8;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#faf3e8;">
      <tr>
        <td align="center" style="padding:28px 16px;">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:100%;background-color:#f7f4ef;border:1px solid #ead9c0;border-radius:12px;overflow:hidden;">
            <tr>
              <td style="background-color:#3b2a1c;padding:16px 20px;">
                <p style="margin:0;font-family:'Fraunces',Georgia,serif;font-size:20px;font-weight:600;color:#ece7df;">Ramon Hub — resumo de ontem</p>
                <p style="margin:3px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#c9a97c;"><%= @stats[:date_label] %></p>
              </td>
            </tr>
            <tr>
              <td style="padding:18px 20px 4px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td valign="top" style="padding-right:14px;">
                      <p style="margin:0;font-family:'Fraunces',Georgia,serif;font-size:24px;font-weight:600;color:#26211b;"><%= @stats[:new_leads] %></p>
                      <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#6b5f52;">novos leads</p>
                    </td>
                    <td valign="top" style="padding-right:14px;">
                      <p style="margin:0;font-family:'Fraunces',Georgia,serif;font-size:24px;font-weight:600;color:#0d7a6a;"><%= @stats[:won][:count] %></p>
                      <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#6b5f52;">ganhos<%= " · #{@stats[:won][:value_label]}" if @stats[:won][:value_label] %></p>
                    </td>
                    <td valign="top" style="padding-right:14px;">
                      <p style="margin:0;font-family:'Fraunces',Georgia,serif;font-size:24px;font-weight:600;color:#b3364f;"><%= @stats[:lost][:count] %></p>
                      <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#6b5f52;"><%= @stats[:lost][:count] == 1 ? 'perdido' : 'perdidos' %><%= " (#{@stats[:lost][:reason]})" if @stats[:lost][:reason] %></p>
                    </td>
                    <td valign="top">
                      <p style="margin:0;font-family:'Fraunces',Georgia,serif;font-size:24px;font-weight:600;color:#7d5432;"><%= @stats[:first_response_label] || '—' %></p>
                      <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#6b5f52;">1ª resposta média</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:12px 20px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="background-color:#f5e6cc;border-radius:8px;padding:12px 14px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#3b2a1c;">
                      <b>Atenção hoje:</b> <%= @attention || 'sem pendências urgentes na fila.' %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:14px 20px 18px;">
                <a href="<%= @command_center_url %>" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;color:#7d5432;text-decoration:none;">Abrir o Centro de Comando →</a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
